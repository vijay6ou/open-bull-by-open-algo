# ============================================================
# OpenBull Configuration
# ============================================================
# Copy this file to .env (gitignored) and fill in values.
# On the Windows VPS, Install-OpenBull.ps1 writes .env once and
# Update-OpenBull.ps1 never overwrites it.

# ---- Core Secrets (REQUIRED - generate unique values) ----
# python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY = "CHANGE_ME_generate_with_secrets_token_hex_32"
ENCRYPTION_PEPPER = "CHANGE_ME_generate_with_secrets_token_hex_32"

# ---- Database ----
DATABASE_URL = "postgresql+asyncpg://postgres:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/openbull"

# ---- Server ----
BACKEND_HOST = "127.0.0.1"
BACKEND_PORT = 8000
FRONTEND_URL = "http://localhost:5173"
FLASK_DEBUG = "false"

# ---- CORS ----
CORS_ORIGINS = "http://127.0.0.1:5173,http://localhost:5173"

# ---- Brokers ----
VALID_BROKERS = "upstox,zerodha,angel,dhan,fyers,jainamxts"

# Jainam DMA / Symphony A (not retail XTS on jtrade.jainam.in:5000)
# Hostlookup: https://smpa.jainam.in:6543/hostlookup
# Interactive: https://smpa.jainam.in:6543/interactive
# Market data: https://smpa.jainam.in:6543/apibinarymarketdata
# Set these on the VPS .env once. Do not commit live keys.
JAINAM_BASE_URL = "https://smpa.jainam.in:6543"
JAINAM_ACTIVE_SYMPHONY_SERVER = "A"
BROKER_API_KEY = ""
BROKER_API_SECRET = ""
BROKER_API_KEY_MARKET = ""
BROKER_API_SECRET_MARKET = ""
JAINAMXTS_API_KEY = ""
JAINAMXTS_API_SECRET = ""
JAINAMXTS_API_KEY_MARKET = ""
JAINAMXTS_API_SECRET_MARKET = ""
JAINAMXTS_CLIENT_ID = "ITC3278A06"

# ---- Logging ----
LOG_LEVEL = "INFO"
LOG_TO_FILE = "true"
LOG_DIR = "logs"
LOG_FILE_MAX_MB = 10
LOG_FILE_BACKUP_COUNT = 9
LOG_COLORS = "true"
ERROR_LOG_DB_MAX_ROWS = 50000

# ---- Rate Limits ----
LOGIN_RATE_LIMIT_MIN = "5 per minute"
LOGIN_RATE_LIMIT_HOUR = "25 per hour"
API_RATE_LIMIT = "50 per second"
ORDER_RATE_LIMIT = "10 per second"

# ---- Session ----
SESSION_EXPIRY_TIME = "03:00"
COOKIE_SECURE = "false"

# ---- WebSocket Proxy ----
WEBSOCKET_HOST = "127.0.0.1"
WEBSOCKET_PORT = 8765
WEBSOCKET_URL = "ws://127.0.0.1:8765"
ZMQ_HOST = "127.0.0.1"
ZMQ_PORT = 5555

# ---- Redis (cache backend) ----
REDIS_URL = "redis://127.0.0.1:6379/0"

# ---- WebSocket Connection Pooling ----
MAX_SYMBOLS_PER_WEBSOCKET = 1000
MAX_WEBSOCKET_CONNECTIONS = 3
ENABLE_CONNECTION_POOLING = "true"

# ============================================================
# OpenBull Configuration
# ============================================================
# Copy this file to .env:
#   cp .env.example .env
# `.env` is gitignored (it will not show up on GitHub).

# ---- Core Secrets ----
APP_SECRET_KEY = "5603c6d817123f759fe4add49e49ea92ad3fc2e5cb3d37215048a64d2e23ad50"
ENCRYPTION_PEPPER = "3822a457d35f095996d7d3a010f20575d9b47b72d6a9d087438ca7a45738e4d6"

# ---- Database ----
DATABASE_URL = "postgresql+asyncpg://postgres:123456@localhost:5432/openbull"

# ---- Server ----
BACKEND_HOST = "127.0.0.1"
BACKEND_PORT = 8000
FRONTEND_URL = "http://localhost:5173"
FLASK_DEBUG = "true"

# ---- CORS ----
CORS_ORIGINS = "http://127.0.0.1:5173,http://localhost:5173"

# ---- Brokers ----
VALID_BROKERS = "upstox,zerodha,angel,dhan,fyers,jainamxts"

# Jainam DMA / Symphony A (not retail XTS on jtrade.jainam.in:5000)
# Hostlookup: https://smpa.jainam.in:6543/hostlookup
# Interactive: https://smpa.jainam.in:6543/interactive
# Market data: https://smpa.jainam.in:6543/apibinarymarketdata
JAINAM_BASE_URL = "https://smpa.jainam.in:6543"
JAINAM_ACTIVE_SYMPHONY_SERVER = "A"
BROKER_API_KEY = "e199e8303e683fa5291560"
BROKER_API_SECRET = "Aijg688$gP"
BROKER_API_KEY_MARKET = "66bb1b49ed7042604bf464"
BROKER_API_SECRET_MARKET = "Mava133@L3"
JAINAMXTS_API_KEY = "e199e8303e683fa5291560"
JAINAMXTS_API_SECRET = "Aijg688$gP"
JAINAMXTS_API_KEY_MARKET = "66bb1b49ed7042604bf464"
JAINAMXTS_API_SECRET_MARKET = "Mava133@L3"
JAINAMXTS_CLIENT_ID = "ITC3278A06"

# ---- Logging ----
LOG_LEVEL = "INFO"
# Rotating file handlers under LOG_DIR. Two files: openbull.log (all levels)
# and openbull-error.log (WARNING+). Each file caps on-disk size at
# (LOG_FILE_BACKUP_COUNT + 1) * LOG_FILE_MAX_MB. Defaults => 100 MB per file.
LOG_TO_FILE = "true"
LOG_DIR = "logs"
LOG_FILE_MAX_MB = 10
LOG_FILE_BACKUP_COUNT = 9
LOG_COLORS = "true"
# DB-backed WARNING+ sink. Old rows are trimmed when this many are exceeded.
ERROR_LOG_DB_MAX_ROWS = 50000

# ---- Rate Limits ----
LOGIN_RATE_LIMIT_MIN = "5 per minute"
LOGIN_RATE_LIMIT_HOUR = "25 per hour"
API_RATE_LIMIT = "50 per second"
ORDER_RATE_LIMIT = "10 per second"

# ---- Session ----
SESSION_EXPIRY_TIME = "03:00"

# ---- WebSocket Proxy ----
WEBSOCKET_HOST = "127.0.0.1"
WEBSOCKET_PORT = 8765
WEBSOCKET_URL = "ws://127.0.0.1:8765"
ZMQ_HOST = "127.0.0.1"
ZMQ_PORT = 5555

# ---- Redis (cache backend) ----
REDIS_URL = "redis://127.0.0.1:6379/0"

# ---- WebSocket Connection Pooling ----
# Most brokers limit symbols per WebSocket (Upstox: 1000, Zerodha: 3000)
# Total capacity = MAX_SYMBOLS_PER_WEBSOCKET x MAX_WEBSOCKET_CONNECTIONS
MAX_SYMBOLS_PER_WEBSOCKET = 1000
MAX_WEBSOCKET_CONNECTIONS = 3
ENABLE_CONNECTION_POOLING = "true"
